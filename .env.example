# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Site URL (canonical + Open Graph). Set to the public origin in each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push Notifications (VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Sentry (error monitoring + session replay). Fill in real values.
# The client DSN must be public; SENTRY_DSN may be the same or a server-only DSN.
NEXT_PUBLIC_SENTRY_DSN=https://<dsn>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_DSN=https://<dsn>@o<org-id>.ingest.sentry.io/<project-id>

# Used by the build to upload source maps (set as a CI secret, not client-side).
SENTRY_ORG=<your-sentry-org-slug>
SENTRY_PROJECT=<your-sentry-project-slug>
SENTRY_AUTH_TOKEN=<your-sentry-auth-token>
